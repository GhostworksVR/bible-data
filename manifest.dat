{
  "version": 1,
  "translationCount": 8,
  "chapters": 9512,
  "verses": 31133,
  "translations": [
    {
      "name": "King James Version",
      "abbreviation": "kjv",
      "subtitle": "The Authorized Version",
      "year": 1611,
      "description": "First published in 1611 under the sponsorship of King James I of England, the King James Version became one of the most influential English Bible translations. Its distinctive literary style has shaped English-speaking religious life and literature for centuries. The text used by a particular dataset may reflect later standardized editions rather than the original 1611 printing."
    },
    {
      "name": "Amplified Bible",
      "abbreviation": "amp",
      "subtitle": "Expanded wording for deeper study",
      "year": 1965,
      "description": "The Amplified Bible uses additional words, explanatory phrases and alternate renderings to help readers explore nuances of the underlying biblical languages. Its distinctive bracketed and parenthetical expansions make it especially useful for close reading and comparing interpretations. Publication and revision details depend on the edition in the source data."
    },
    {
      "name": "American Standard Version",
      "abbreviation": "asv",
      "subtitle": "A formal English revision",
      "year": 1901,
      "description": "Published in 1901, the American Standard Version revised the English Revised Version with input from American scholars. It is known for its relatively literal translation style and historically significant choices of terminology. It remains useful for readers comparing older English renderings of biblical passages."
    },
    {
      "name": "Geneva Bible",
      "abbreviation": "gnv",
      "subtitle": "The Bible of the Protestant Reformation",
      "year": 1560,
      "description": "First published in 1560, the Geneva Bible was an influential English translation produced by Protestant scholars in Geneva. It became known for its study notes and was widely read before the King James Version."
    },
    {
      "name": "New International Version",
      "abbreviation": "niv",
      "subtitle": "Contemporary English translation",
      "year": 1978,
      "description": "The New International Version was created by an international team of biblical scholars to balance accuracy with natural, contemporary English. It is widely read for personal study, church use and public reading. Wording varies by edition and revision."
    },
    {
      "name": "New King James Version",
      "abbreviation": "nkjv",
      "subtitle": "Traditional style in updated English",
      "year": 1982,
      "description": "The New King James Version updates the language of the King James tradition while seeking to preserve much of its cadence and translation approach. It offers a more contemporary reading experience for readers familiar with the Authorized Version."
    },
    {
      "name": "World English Bible",
      "abbreviation": "web",
      "subtitle": "A modern public-domain English Bible",
      "year": 2000,
      "description": "The World English Bible is a modern English translation based on the American Standard Version and updated using biblical-language source texts. It aims for clear, accessible language while retaining a relatively formal translation style. It is widely used in digital Bible projects."
    },
    {
      "name": "Young's Literal Translation",
      "abbreviation": "ylt",
      "subtitle": "A Strictly Literal Translation of the Bible",
      "year": 1862,
      "description": "Translated by Robert Young and first published in 1862, with revisions published in 1887 and 1898. Young sought to preserve the grammar, tense and phrasing of the Hebrew and Greek source texts, resulting in a distinctive, highly literal English rendering. Many digital copies reproduce the 1898 revision rather than the first edition."
    }
  ],
